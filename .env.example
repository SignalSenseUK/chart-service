# Application
APP_ENV=development
LOG_LEVEL=INFO
BASE_URL=http://localhost:8000

# Database
# DATABASE_URL is the async SQLAlchemy URL. Refer to SQLAlchemy/asyncpg docs for the format.
DATABASE_URL=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# EODHD provider
EODHD_API_KEY=
EODHD_TIMEOUT_MS=30000

# Interactive Brokers provider
IB_HOST=
IB_PORT=
IB_CLIENT_ID=
IB_TIMEOUT_MS=30000

# PNG export via browser sidecar
EXPORT_BROWSER_WS_ENDPOINT=
EXPORT_TIMEOUT_MS=15000
PNG_MIN_WIDTH=320
PNG_MIN_HEIGHT=200
PNG_MAX_WIDTH=2400
PNG_MAX_HEIGHT=1600
